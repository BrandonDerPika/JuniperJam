MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 724677615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c7784192525ad442aa68bba6211222d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  levels:
  - levelName: Tutorial
    circlePlanetLimit: 0
    trianglePlanetLimit: 0
    squarePlanetLimit: 0
    levelLayoutObject: {fileID: 1585582761}
    previewStartPoint: {fileID: 0}
    previewEndPoint: {fileID: 0}
    startPointWaitTime: 0
    levelEndObject: {fileID: 252094719}
    waveOriginObject: {fileID: 252094719}
    levelDialogue:
    - Ah... eternity... you ever sit with it?
    - I have. It doesn't get better with time, just longer.
    - 'I''ve created stars, galaxies, '
    - even black holes because I thought 'that'll surely keep things interesting!'
    - It did. Briefly.
    - But eventually... everything settles into the same predictable patterns...
    - So I had an idea...
    - Planetary billiards.
    - The rules are simple.
    - Plan
    - Throw
    - ...EXPLODE!
    - Ready?
  - levelName: Level 1
    circlePlanetLimit: 0
    trianglePlanetLimit: 0
    squarePlanetLimit: 0
    levelLayoutObject: {fileID: 350709088}
    previewStartPoint: {fileID: 1929488861}
    previewEndPoint: {fileID: 1190485775}
    startPointWaitTime: 2.5
    levelEndObject: {fileID: 1664119515}
    waveOriginObject: {fileID: 1664119515}
    levelDialogue:
    - Better... but still not enough. I NEED more explosions!
    - Maybe a quick spin around this planet ought to work.
  - levelName: Level 2
    circlePlanetLimit: 0
    trianglePlanetLimit: 0
    squarePlanetLimit: 1
    levelLayoutObject: {fileID: 1740457109}
    previewStartPoint: {fileID: 0}
    previewEndPoint: {fileID: 0}
    startPointWaitTime: 0
    levelEndObject: {fileID: 582562778}
    waveOriginObject: {fileID: 582562778}
    levelDialogue:
    - This'll be a fun one, no clean shot!
    - I'll just have to manifest something new
  - levelName: Level 3
    circlePlanetLimit: 0
    trianglePlanetLimit: 0
    squarePlanetLimit: 0
    levelLayoutObject: {fileID: 1805446532}
    previewStartPoint: {fileID: 784877168}
    previewEndPoint: {fileID: 1516350666}
    startPointWaitTime: 2
    levelEndObject: {fileID: 784877168}
    waveOriginObject: {fileID: 784877168}
    levelDialogue:
    - This is getting messy... I like it.
    - Pushing that rock will clean that cluster right up!
  - levelName: Level 4
    circlePlanetLimit: 0
    trianglePlanetLimit: 0
    squarePlanetLimit: 0
    levelLayoutObject: {fileID: 1370192202}
    previewStartPoint: {fileID: 881906610}
    previewEndPoint: {fileID: 374064460}
    startPointWaitTime: 2.5
    levelEndObject: {fileID: 374064460}
    waveOriginObject: {fileID: 881906610}
    levelDialogue:
    - Ahh now this one should make a fine explosion!
    - I can make a quick stop at that marked asteroid, then make the whole place
      light up!
    - God, I love explosions!
  - levelName: Level 5
    circlePlanetLimit: 0
    trianglePlanetLimit: 0
    squarePlanetLimit: 1
    levelLayoutObject: {fileID: 1953275997}
    previewStartPoint: {fileID: 617539798}
    previewEndPoint: {fileID: 1312748686}
    startPointWaitTime: 2.5
    levelEndObject: {fileID: 1284740644}
    waveOriginObject: {fileID: 617539798}
    levelDialogue:
    - Ahh, a chain reaction this one! Sure to make only the best of explosions!
  currentLevelIndex: 0
  plannerScript: {fileID: 724677620}
